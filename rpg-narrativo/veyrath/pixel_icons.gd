extends RefCounted

const MASKS := {
	"heart": ["0110110","1111111","1111111","0111110","0011100","0001000"],
	"flow": ["0001000","0011100","0111000","0011110","0001100","0010000"],
	"coin": ["0011100","0101010","1010101","1010101","0101010","0011100"],
	"book": ["1100011","1010101","1001001","1001001","1010101","1100011"],
	"bandage": ["0011000","0111100","1111110","0111111","0011110","0001100"],
	"bolt": ["0001000","0011100","0010100","0111110","0001000","0011100"],
	"cannon": ["0000000","0111111","0111100","0011000","0111110","0101010"],
	"enemy": ["0011100","0111110","0101010","0011100","0010100","0100010"],
	"heavy": ["0011100","0111110","1111111","1110111","0111110","0100010"],
	"build": ["0000000","0001000","0001000","0111110","0001000","0001000"],
	"road": ["0000000","0000000","0011100","0011100","0000000","0000000"],
	"shield": ["0111110","0101010","0101010","0111110","0011100","0001000"],
}

static func icon(key: String, tint: Color, scale_pixels: int = 3) -> Texture2D:
	var rows: Array = MASKS[key]
	var image := Image.create(7 * scale_pixels,6 * scale_pixels,false,Image.FORMAT_RGBA8)
	for y in range(rows.size()):
		for x in range(7):
			if rows[y][x] == "1":
				image.fill_rect(Rect2i(x*scale_pixels,y*scale_pixels,scale_pixels,scale_pixels),tint)
	return ImageTexture.create_from_image(image)
